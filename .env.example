# ---- API keys (free-tier) ----
GROQ_API_KEY=
# NOTE: verify the exact var name your Gemini client library expects before
# assuming this one -- the langchain_google_genai wrapper specifically wants
# GOOGLE_API_KEY, not GEMINI_API_KEY, and this has bitten a prior build.
GOOGLE_API_KEY=
TAVILY_API_KEY=

# ---- Qdrant (Step 3) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Ingestion / chunking (FR-1) ----
CHUNK_SIZE_MIN=200
CHUNK_SIZE_MAX=500
CHUNK_OVERLAP_PCT=0.125

# ---- Retrieval (FR-4, FR-5, FR-6) ----
TOP_N_SPARSE=20
TOP_N_DENSE=20
RRF_K=60
RERANK_TOP_K_DEEP=15
RERANK_TOP_K_FAST=5

# ---- Embedding config, pinned centrally (Risk #5) ----
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_TASK_TYPE_DOC=document
GEMINI_EMBEDDING_TASK_TYPE_QUERY=query
GEMINI_EMBEDDING_DIMENSION=768

# ---- Routing (FR-12, FR-13, addendum #2) ----
TAU_LOW=0.3
TAU_HIGH=0.6
ROUTER_TIMEOUT_MS=400
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_MID=llama-3.3-70b-versatile
GROQ_MODEL_DEEP=openai/gpt-oss-120b

# ---- Tavily fallback (FR-9) ----
TAVILY_CONFIDENCE_FLOOR=0.02

# ---- API surface (FR-17) ----
MAX_QUERY_LENGTH=2000

# ---- Budget (NFR-4) ----
API_CALL_BUDGET=4

# ---- Extended capabilities (Phase 7, default off/rrf) ----
FUSION_STRATEGY=rrf
CACHING_ENABLED=false
